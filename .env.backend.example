# These are examples only. Configure real values in your shell/IDE or Render dashboard.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/linkhub_db?useSSL=true&requireSSL=true
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_OUTPUT_FROM_openssl_rand_-base64_64
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=https://linkhub.vercel.app
LINKHUB_PUBLIC_BASE_URL=https://YOUR_RENDER_SERVICE.onrender.com
LINKHUB_UPLOAD_DIR=uploads
# Optional; only needed if the Cloudinary integration is enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
